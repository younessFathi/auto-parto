[Unit]
Description=Apply a complete OpenBao-rendered Auto-Parto credential bundle
After=auto-parto-app.service

[Service]
Type=oneshot
User=root
ExecStart=/usr/local/sbin/auto-parto-apply-secret-bundle
NoNewPrivileges=true
CapabilityBoundingSet=CAP_CHOWN CAP_FOWNER
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/auto-parto/secrets /run/auto-parto/audit
ExecStartPost=/usr/bin/systemctl restart auto-parto-app.service
