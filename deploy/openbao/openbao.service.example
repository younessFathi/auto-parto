[Unit]
Description=OpenBao secret service
Requires=docker.service
After=docker.service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/etc/openbao
ExecStart=/usr/bin/docker compose --env-file /etc/openbao/deployment.env --file /etc/openbao/compose.production.yml up -d --wait --wait-timeout 90 openbao
ExecStop=/usr/bin/docker compose --env-file /etc/openbao/deployment.env --file /etc/openbao/compose.production.yml stop openbao
TimeoutStartSec=120
TimeoutStopSec=60
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
