# Copy to a root-owned, mode-0600 deployment.env on the dedicated OpenBao host.
# Values below are non-secret deployment paths/addresses; never put tokens here.
OPENBAO_PRIVATE_BIND_IP=10.20.30.10
OPENBAO_API_PUBLISHED_PORT=8200
OPENBAO_CLUSTER_PUBLISHED_PORT=8201
OPENBAO_TLS_SERVER_NAME=openbao-secrets.internal
OPENBAO_SERVER_CONFIG=/etc/openbao/server.hcl
OPENBAO_TLS_DIR=/etc/openbao/tls
OPENBAO_DATA_VOLUME=auto-parto-openbao-prod-data
