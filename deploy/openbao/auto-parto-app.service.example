[Unit]
Description=Auto-Parto production application container
Requires=docker.service openbao-agent.service
After=docker.service openbao-agent.service
PartOf=openbao-agent.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/auto-parto
EnvironmentFile=-/etc/auto-parto/deploy.env
ExecStartPre=/usr/local/sbin/auto-parto-check-secret-bundle --wait-seconds 120
ExecStart=/usr/bin/docker compose --env-file /etc/auto-parto/deploy.env -f docker-compose.prod.yml --profile production up -d --no-deps springboot-postgresql-app
ExecStop=/usr/bin/docker compose --env-file /etc/auto-parto/deploy.env -f docker-compose.prod.yml --profile production stop springboot-postgresql-app
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
