#!/usr/bin/env bash
set -euo pipefail
set +x

wait_seconds=0
if [[ "${1:-}" == "--wait-seconds" && "${2:-}" =~ ^[0-9]+$ ]]; then
  wait_seconds="$2"
elif [[ $# -gt 0 ]]; then
  printf 'Invalid secret readiness arguments.\n' >&2
  exit 2
fi

secret_dir="${AUTO_PARTO_SECRET_DIR:-/run/auto-parto/secrets}"
audit_dir="${AUTO_PARTO_AUDIT_SECRET_DIR:-/run/auto-parto/audit}"
expected_group="${AUTO_PARTO_SECRET_GROUP:-10001}"

has_value() {
  local file="$1" key="$2"
  awk -F= -v key="$key" '$1 == key && length(substr($0, length(key) + 2)) > 0 { found = 1 } END { exit !found }' "$file"
}

file_mode() {
  stat -c '%a' "$1" 2>/dev/null || stat -f '%Lp' "$1"
}

file_group() {
  stat -c '%g' "$1" 2>/dev/null || stat -f '%g' "$1"
}

bundle_ready() {
  local file="$secret_dir/secrets.properties" key
  [[ -f "$file" && ! -L "$file" ]] || return 1
  [[ "$(file_mode "$file")" == "440" ]] || return 1
  [[ "$(file_group "$file")" == "$expected_group" ]] || return 1
  for key in spring.r2dbc.username spring.r2dbc.password spring.data.redis.password \
    auto.parto.storage.s3.access-key auto.parto.storage.s3.secret-key \
    jwt.signing.algorithm jwt.signing.key-id jwt.signing.private-key jwt.signing.verification-keys; do
    has_value "$file" "$key" || return 1
  done
  [[ "$(awk -F= '$1 == "jwt.signing.algorithm" { print $2; exit }' "$file")" == "RS256" ]]

  if [[ "${RESEND_ENABLED:-false}" == "true" ]]; then
    has_value "$file" resend.api-key || return 1
  fi
  if [[ "${FIREBASE_ENABLED:-false}" == "true" ]]; then
    has_value "$file" firebase.credentials.json || return 1
  fi

  if [[ "${APP_AUDIT_OUTBOX_ENABLED:-false}" == "true" ]]; then
    file="$audit_dir/secrets.properties"
    [[ -f "$file" && ! -L "$file" ]] || return 1
    [[ "$(file_mode "$file")" == "440" ]] || return 1
    [[ "$(file_group "$file")" == "$expected_group" ]] || return 1
    has_value "$file" auto.parto.audit.username && has_value "$file" auto.parto.audit.password || return 1
  fi
}

deadline=$((SECONDS + wait_seconds))
until bundle_ready; do
  if (( SECONDS >= deadline )); then
    printf 'OpenBao-rendered production credential bundle is unavailable or incomplete.\n' >&2
    exit 1
  fi
  sleep 1
done
