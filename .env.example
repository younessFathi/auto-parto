# =============================================================================
# Auto Parto — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# WARNING: Never commit .env to version control. It contains secrets.
# =============================================================================

# --- Spring Profile ---
SPRING_PROFILES_ACTIVE=local

# --- MongoDB ---
# For MongoDB Atlas, use mongodb+srv:// and URL-encode reserved characters in
# the username or password (for example, @ becomes %40). Keep this in .env or
# a protected deployment secret; never commit the real URI.
MONGODB_URI=mongodb://localhost:27017/auto-parto

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# Generate with: openssl rand -base64 32
JWT_SECRET=your-256-bit-base64-encoded-secret

# --- Firebase Cloud Messaging ---
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_JSON=

# --- Resend (Email) ---
RESEND_API_KEY=your-resend-api-key
