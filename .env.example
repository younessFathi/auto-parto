# =============================================================================
# Auto Parto — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# WARNING: Never commit .env to version control. It contains secrets.
# =============================================================================

# --- Spring Profile ---
SPRING_PROFILES_ACTIVE=local

# --- PostgreSQL ---
APP_POSTGRES_R2DBC_URL=r2dbc:postgresql://localhost:5432/auto_parto
APP_POSTGRES_USER=auto_parto
APP_POSTGRES_PASSWORD=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---
# Generate with: openssl rand -base64 32
JWT_SECRET=your-256-bit-base64-encoded-secret

# --- Firebase Cloud Messaging ---
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_JSON=

# --- Resend (Email) ---
RESEND_API_KEY=your-resend-api-key
