# =============================================================================
# Auto Parto — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# WARNING: Never commit .env to version control. It contains secrets.
# =============================================================================

# --- Spring Profile ---
SPRING_PROFILES_ACTIVE=local

# --- PostgreSQL ---
APP_POSTGRES_R2DBC_URL=r2dbc:postgresql://localhost:5432/auto_parto
APP_POSTGRES_USER=auto_parto
APP_POSTGRES_PASSWORD=

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Protected production secret delivery ---
APP_SECRET_PROVIDER=openbao
OPENBAO_ADDR=https://openbao.example.internal
OPENBAO_ROLE=auto-parto
OPENBAO_AUTH_METHOD=kubernetes

# --- JWT ---
# Generate with: openssl rand -base64 32
JWT_SECRET=your-256-bit-base64-encoded-secret

# --- Firebase Cloud Messaging ---
FIREBASE_ENABLED=false
FIREBASE_CREDENTIALS_JSON=

# --- Resend (Email) ---
RESEND_API_KEY=your-resend-api-key

# --- Production object storage ---
APP_FILE_STORAGE_PROVIDER=s3
APP_FILE_STORAGE_S3_ENDPOINT=https://s3.example.internal
APP_FILE_STORAGE_S3_BUCKET=auto-parto-files
APP_FILE_STORAGE_S3_ACCESS_KEY=
APP_FILE_STORAGE_S3_SECRET_KEY=
